# Use SQLite for a zero-configuration local setup.
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# To use MySQL instead, uncomment and configure these values:
# DB_ENGINE=mysql
# DB_NAME=food_management_db
# DB_USER=root
# DB_PASSWORD=change-me
# DB_HOST=127.0.0.1
# DB_PORT=3306
